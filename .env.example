NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side AI. Choose one provider and configure only its secret key.
# Supported values: gemini, groq, openrouter, huggingface, mock
AI_PROVIDER=
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Optional model overrides. Leave blank to use the app defaults.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_MODEL=openrouter/free
# HUGGINGFACE_MODEL=zai-org/GLM-4.5V:fastest

# Optional OpenRouter attribution header.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Puter.js remains available as a separate client-side option and does not
# need an API key. The user authorizes Puter directly in the browser.

# Optional compatibility with the new Supabase publishable key name.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Required only for the server-side user invitation endpoint.
# Never add NEXT_PUBLIC_ to this variable and never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Android remote push notifications. These values are only read by the
# server-side delivery webhook and must never use a NEXT_PUBLIC_ prefix.
# Keep this false until android/app/google-services.json is configured and
# the APK/AAB is rebuilt with Firebase.
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
NEXT_PUBLIC_ANDROID_FIREBASE_CONFIGURED=false
# SUPABASE_SERVICE_ROLE_KEY= # required by /api/internal/push/partner-notification
PUSH_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
